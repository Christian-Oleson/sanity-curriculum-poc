<?xml version="1.0" encoding="UTF-8"?>
<!-- Stand-in for MathML 3: .NET's XSD 1.0 engine can't compile the official mathml3.xsd.
     QTI only references m3:math; this accepts any <math> content without validating it. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/1998/Math/MathML" elementFormDefault="qualified">
  <xs:element name="math">
    <xs:complexType mixed="true">
      <xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
