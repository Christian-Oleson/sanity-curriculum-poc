# Copy to .env.local and fill in. Never commit .env.local.

# Sanity read token (Viewer role). The dataset is private, so the site reads with this server-side.
# Create one: npx sanity tokens add "Web preview" --role viewer   (run in the Studio folder)
SANITY_API_READ_TOKEN=

# Shared secret for the staff-only QTI export (/api/qti/<id>). Any long random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QTI_EXPORT_TOKEN=
